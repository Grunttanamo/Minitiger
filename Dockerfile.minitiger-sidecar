# syntax=docker/dockerfile:1.7

# Minitiger Web Sidecar
#
# Builds the Minitiger Jellyfin Web frontend from this repository and serves it
# from a tiny nginx container. The existing Jellyfin server stays completely
# separate and is reached through a reverse proxy.

FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS web-builder
WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci --no-audit

COPY . .
ARG JELLYFIN_VERSION=12.1
ENV JELLYFIN_VERSION=$JELLYFIN_VERSION
RUN npm run build:production

FROM nginx:1.29-alpine

LABEL org.opencontainers.image.title="Minitiger Web"
LABEL org.opencontainers.image.description="Custom Jellyfin 12.1 web frontend delivered as a safe sidecar. Keep your existing Jellyfin server, database, users, libraries and settings untouched while using the Minitiger interface in a separate container."
LABEL org.opencontainers.image.source="https://github.com/Grunttanamo/Minitiger"
LABEL org.opencontainers.image.url="https://github.com/Grunttanamo/Minitiger/pkgs/container/minitiger-web"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"
LABEL org.opencontainers.image.vendor="Grunttanamo"

# Works out of the box for the common case where Jellyfin is published on the
# Docker host at port 8096. Can be overridden at runtime.
ENV JELLYFIN_URL=http://host.docker.internal:8096

RUN rm -rf /usr/share/nginx/html/* \
    && mkdir -p /usr/share/nginx/html/web

COPY --from=web-builder /src/dist/ /usr/share/nginx/html/web/
COPY docker/minitiger-sidecar.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/minitiger-health || exit 1
