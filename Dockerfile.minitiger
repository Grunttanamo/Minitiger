# syntax=docker/dockerfile:1.7

# Minitiger Web is built from this repository, then placed into the official
# Jellyfin 12.0 image. The companion plugin is built as a managed .NET plugin
# and installed into the persistent /config volume by the startup wrapper.

ARG JELLYFIN_BASE_IMAGE=jellyfin/jellyfin:12.0

FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS web-builder
WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci --no-audit

COPY . .
ARG JELLYFIN_VERSION=12.0
ENV JELLYFIN_VERSION=$JELLYFIN_VERSION
RUN npm run build:production

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0-bookworm-slim AS plugin-builder
WORKDIR /src
COPY tools/MinitigerVirtualSync/ ./tools/MinitigerVirtualSync/
RUN dotnet restore tools/MinitigerVirtualSync/Jellyfin.Plugin.MinitigerVirtualSync.csproj \
    && dotnet publish tools/MinitigerVirtualSync/Jellyfin.Plugin.MinitigerVirtualSync.csproj \
       -c Release \
       -o /out \
       --no-self-contained

FROM ${JELLYFIN_BASE_IMAGE}

LABEL org.opencontainers.image.title="Minitiger Jellyfin"
LABEL org.opencontainers.image.description="Jellyfin 12.0 with Minitiger Web and Minitiger Virtual Sync"

# Replace the web client bundled with the official image.
RUN rm -rf /jellyfin/jellyfin-web/*
COPY --from=web-builder /src/dist/ /jellyfin/jellyfin-web/

# Keep the plugin outside /config in the immutable image. The entrypoint copies
# it into /config/plugins on every start so a mounted config volume works too.
RUN mkdir -p /opt/minitiger
COPY --from=plugin-builder /out/Jellyfin.Plugin.MinitigerVirtualSync.dll /opt/minitiger/Jellyfin.Plugin.MinitigerVirtualSync.dll
COPY docker/minitiger-entrypoint.sh /opt/minitiger/minitiger-entrypoint.sh
RUN chmod 755 /opt/minitiger/minitiger-entrypoint.sh

ENTRYPOINT ["/opt/minitiger/minitiger-entrypoint.sh"]
