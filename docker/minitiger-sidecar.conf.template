server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    client_max_body_size 0;

    # Tiny health endpoint used by Docker's HEALTHCHECK.
    location = /minitiger-health {
        access_log off;
        default_type text/plain;
        return 200 "Minitiger Sidecar OK\n";
    }

    # Always enter Jellyfin Web through the real HTML entry file.
    # /web/ alone can leave browser clients on a route Jellyfin treats as
    # missing, while desktop clients may normalize the URL automatically.
    location = / {
        return 302 /web/index.html;
    }

    location = /web {
        return 302 /web/index.html;
    }

    location = /web/ {
        return 302 /web/index.html;
    }

    # Minitiger itself is completely local to this container.
    location /web/ {
        try_files $uri $uri/ /web/index.html;
    }

    # Everything that is not a local web asset is forwarded to the user's
    # already-running Jellyfin server. This includes REST API calls, media
    # streams, images and the Jellyfin WebSocket endpoint.
    location / {
        proxy_pass ${JELLYFIN_URL};
        proxy_http_version 1.1;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Playback and large uploads should stream instead of being buffered by
        # the sidecar.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
